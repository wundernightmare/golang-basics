# tasks justfile
# Install: cargo install just | brew install just | mise use just
# Usage:   just <recipe>      | just --list

# Show all available recipes
default:
    @just --list --unsorted

# ── Build ─────────────────────────────────────────────────────────────────────

# Compile the package (also surfaces type errors fast)
build:
    go build ./...

# Build a static, stripped release binary into ./bin/tasks
release:
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o bin/tasks .

# Build and run the service locally (TASKS_* env vars apply; needs the deps up)
run *args:
    go run . {{args}}

# Vet + type-check without producing artefacts (fastest feedback)
check:
    go vet ./...

# ── Test ──────────────────────────────────────────────────────────────────────

# Run all tests. The internal/integration suite spins up Postgres + Valkey +
# Kafka via testcontainers and needs a working Docker/Podman socket.
test *args:
    go test ./... {{args}}

# Unit tests only — skips the container-backed integration suite (no Docker)
test-short:
    go test -short ./...

# Run only the full-stack integration test (Postgres + Valkey + Kafka)
test-integration:
    go test -run TestTasksEndToEnd -v ./internal/integration/

# Run tests with the race detector and verbose output
test-verbose:
    go test -race -v ./...

# ── Coverage ──────────────────────────────────────────────────────────────────

# Run all tests and print a per-function coverage summary
cov:
    go test -coverprofile=coverage.out ./...
    go tool cover -func=coverage.out

# ── Lint & Format ─────────────────────────────────────────────────────────────

# golangci-lint — the aggregate linter (config in repo-root .golangci.yml)
lint:
    golangci-lint run

# golangci-lint — auto-fix where possible
lint-fix:
    golangci-lint run --fix

# Format all source files in-place (gofmt + import grouping)
fmt:
    gofmt -w .
    golangci-lint fmt

# Check formatting without modifying files (CI gate)
fmt-check:
    test -z "$(gofmt -l .)" || { echo "gofmt needed:"; gofmt -l .; exit 1; }

# ── Modules & Security ────────────────────────────────────────────────────────

# Tidy go.mod / go.sum
tidy:
    go mod tidy

# Known-vulnerability scan of this module's dependency graph
audit:
    go run golang.org/x/vuln/cmd/govulncheck@latest ./...

# Show the direct dependency list
deps:
    go list -m all

# ── CI ────────────────────────────────────────────────────────────────────────

# Full per-package CI pipeline: format → vet → lint → unit tests
ci: fmt-check check lint test-short
    @echo "CI passed"

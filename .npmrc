# pnpm config. The e2e suite is plain Playwright + tsx, so the default isolated
# node_modules layout is fine (no TypeSpec hoisting needed, unlike the Rust
# sibling repo).
strict-peer-dependencies=false
auto-install-peers=true

# Closed network: point pnpm at the internal npm mirror (corepack needs
# COREPACK_NPM_REGISTRY as well — see .env.example).
#registry=https://npm.internal

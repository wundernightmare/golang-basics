            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (state) (pgxpool_conns{service=\"tasks\"})",
          "legendFormat": "{{state}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pgxpool_max_conns{service=\"tasks\"})",
          "legendFormat": "max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Cache hit ratio (tasks)",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 25,
        "w": 8,
        "h": 8

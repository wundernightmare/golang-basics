      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(cache_lookups_total{result=\"hit\"}[5m])) / sum(rate(cache_lookups_total{result=~\"hit|miss\"}[5m]))",
          "legendFormat": "hit ratio"

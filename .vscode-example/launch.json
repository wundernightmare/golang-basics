{
  // Copy this file to .vscode/launch.json
  //
  // Debugging runs through Delve (dlv), pinned in mise.toml and wired up in
  // settings.json → go.alternateTools. The service configs below talk to the
  // local dependency stack on its host ports, so bring that up first:
  //
  //     just infra-up      # postgres :5432, valkey :6379, redpanda :9092
  //
  // (`just stack-up` also starts the services themselves in containers, which
  // would fight these for the host ports — use infra-up when debugging.)
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: ping",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/ping",
      "env": {
        "PING_HTTP_ADDR": ":8080",
        "PING_LOG_FORMAT": "text",
        "PING_LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Debug: heartbeat",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/heartbeat",
      "env": {
        "HEARTBEAT_HTTP_ADDR": ":8081",
        "HEARTBEAT_INTERVAL": "5s",
        "HEARTBEAT_LOG_FORMAT": "text",
        "HEARTBEAT_LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Debug: tasks",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/tasks",
      "env": {
        "TASKS_HTTP_ADDR": ":8082",
        "TASKS_DATABASE_URL": "postgres://app:app@localhost:5432/app?sslmode=disable",
        "TASKS_VALKEY_URL": "valkey://localhost:6379",
        "TASKS_KAFKA_BROKERS": "localhost:9092",
        "TASKS_KAFKA_TOPIC": "tasks.events",
        "TASKS_LOG_FORMAT": "text",
        "TASKS_LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Debug: consumer",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/services/consumer",
      "env": {
        "CONSUMER_HTTP_ADDR": ":8083",
        "CONSUMER_KAFKA_BROKERS": "localhost:9092",
        "CONSUMER_KAFKA_TOPIC": "tasks.events",
        "CONSUMER_KAFKA_GROUP": "tasks-consumer",
        "CONSUMER_LOG_FORMAT": "text",
        "CONSUMER_LOG_LEVEL": "debug"
      }
    },
    {
      // Breakpoint the test function the cursor is in. The testcontainers-backed
      // integration tests start their own containers and need Docker running.
      "name": "Debug: test at cursor",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-test.run", "${selectedText}"]
    },
    {
      "name": "Debug: tests in current package",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      // Attach to a service already running under `dlv --headless`, e.g. one
      // started by `just up` with dlv wrapped around the binary.
      "name": "Attach: dlv headless :2345",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "host": "127.0.0.1",
      "port": 2345
    }
  ],
  "compounds": [
    {
      "name": "Debug: tasks + consumer",
      "configurations": ["Debug: tasks", "Debug: consumer"],
      "stopAll": true
    }
  ]
}

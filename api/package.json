{
  "name": "@golang-basics/api",
  "version": "0.0.0",
  "private": true,
  "description": "API and event contracts in TypeSpec — the source the OpenAPI document, the JSON Schemas and the Go types are generated from",
  "scripts": {
    "compile": "pnpm compile:tasks && pnpm compile:ping",
    "compile:tasks": "tsp compile tsp/main.tsp --option @typespec/openapi3.output-file=tasks.openapi.yaml",
    "compile:ping": "tsp compile tsp/ping.tsp --option @typespec/openapi3.output-file=ping.openapi.yaml",
    "clean": "rm -rf openapi3 jsonschema"
  },
  "devDependencies": {
    "@typespec/compiler": "catalog:",
    "@typespec/http": "catalog:",
    "@typespec/openapi": "catalog:",
    "@typespec/openapi3": "catalog:",
    "@typespec/json-schema": "catalog:"
  }
}

# ── Go ────────────────────────────────────────────────────────────────────────
# Build output / test binaries
/services/*/bin/
*.exe
*.test
*.out
coverage.out
coverage.html
# `dlv debug` / VS Code F5 drop a build artefact next to the debugged package
__debug_bin*
# CI relocates GOMODCACHE/GOCACHE here (GitLab only caches paths inside the
# project dir) and builds its Go tools into /bin; gitlab-ci-local leaves both
# behind when run locally.
/.cache/
/bin/
/.gitlab-ci-local/
versions.env

# go.work is COMMITTED (it defines the workspace). go.work.sum is too, when present.

# ── Node / e2e ────────────────────────────────────────────────────────────────
node_modules/
e2e/playwright-report/
e2e/test-results/
e2e/.e2e-state.json
e2e/dist/

# ── Benchmarks ────────────────────────────────────────────────────────────────
benchmarks/results/
benchmarks/node_modules/

# ── Local run state (just up / host-services-spawn.sh) ────────────────────────
.run/

# ── Secrets (machine-local; mirrored into worktrees by the `wt` helper) ───────
.env
.env.*
!.env.example
cosign.key
*.pem

# ── Editors / OS ──────────────────────────────────────────────────────────────
# `.vscode/` (with a trailing slash) excludes the directory itself, and git
# cannot re-include a file inside an excluded directory — so the negation below
# only works if the pattern matches the *contents* instead.
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.log

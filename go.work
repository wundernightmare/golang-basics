// go.work — workspace file tying together every module in the monorepo.
//
// This is the Go analogue of a Cargo workspace: each "member" is its own
// module with its own go.mod (mirroring one crate = one module), and the
// workspace makes local cross-module imports resolve to the on-disk source
// rather than a published version. Run `go work sync` after adding a module.
//
// Members:
//   e2e                         — end-to-end suite: spawns the service binaries (go test -tags e2e)
//   libs/contracts              — generated Go types of the TypeSpec contracts (api/): tasks HTTP API + Kafka events
//   libs/grpcx                  — policy-per-target outbound gRPC connections (service config, CB, metrics, tracing)
//   libs/grpcx/integration      — its integration suite: a real gRPC server (Jaeger), TLS, an HTTP gateway, Toxiproxy (_test only)
//   libs/httpx                  — shared HTTP server scaffolding (the example common lib)
//   libs/resilience             — circuit breaker + retry budget shared by the outbound clients (HTTP, gRPC)
//   libs/resilient-http-client  — policy-per-target outbound HTTP client (rate limit, CB, retry…)
//   libs/resilient-http-client/integration — its integration suite: real servers (Caddy, Redpanda, Postgres), HTTP/1.1–3, TLS, Toxiproxy (_test only)
//   libs/pgx                    — shared PostgreSQL pool (pgx)
//   libs/valkey                 — shared Valkey cache (valkey-go)
//   libs/kafka                  — shared Kafka producer/consumer, provider-neutral (no cgo)
//   libs/kafka-rdkafka          — Kafka provider: librdkafka via confluent-kafka-go (cgo; the default)
//   libs/kafka-franz            — Kafka provider: franz-go (pure Go)
//   libs/secret                 — secret.String: a config value no formatter, logger or marshaller prints; Expose() is the only way out
//   libs/secret/compat          — libs/secret against YAML, caarlos0/env and mapstructure (_test only)
//   libs/s3                     — shared S3 client (aws-sdk-go-v2): bounded calls, streaming uploads
//   libs/otelx                  — shared OpenTelemetry tracing setup
//   libs/otelx/integration      — its integration suite: the shipped collector config (tail sampling) in a real collector, in front of Jaeger (_test only)
//   libs/tiercache              — two-level cache: off-heap fastcache L1 + Valkey L2 (SWR, Pub/Sub invalidation)
//   libs/testx                  — shared test harness (signal helpers, unique names; _test only, no Docker)
//   libs/testx/containers       — shared containers + chaos helpers (testcontainers, Toxiproxy; _test only)
//   libs/testx/contract         — OpenAPI / JSON Schema validation of exchanges (_test only)
//   services/ping               — ping/pong HTTP service
//   services/heartbeat          — background heartbeat worker (+ health/metrics HTTP)
//   services/tasks              — Tasks CRUD over Postgres + Valkey + Kafka + OTel
//   services/ingest             — event ingest: POST /events → Kafka + S3 archive (either sink acks), archive compaction
//   services/consumer           — Kafka consumer worker draining tasks.events
go 1.27.0

use (
	./e2e
	./libs/contracts
	./libs/grpcx
	./libs/grpcx/integration
	./libs/httpx
	./libs/kafka
	./libs/kafka-franz
	./libs/kafka-rdkafka
	./libs/otelx
	./libs/otelx/integration
	./libs/pgx
	./libs/resilience
	./libs/resilient-http-client
	./libs/resilient-http-client/integration
	./libs/s3
	./libs/secret
	./libs/secret/compat
	./libs/testx
	./libs/testx/containers
	./libs/testx/contract
	./libs/tiercache
	./libs/valkey
	./services/consumer
	./services/heartbeat
	./services/ingest
	./services/ping
	./services/tasks
)
